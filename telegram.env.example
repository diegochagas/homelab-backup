# Telegram notifications
#
# Copy to telegram.env (gitignored) on
# every machine that runs a backup
# script. Without it the scripts work
# as usual, just without messages.
#
# 1. @BotFather -> /newbot -> token
# 2. Message the bot, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    and read message.chat.id
########################################

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
