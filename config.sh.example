#!/usr/bin/env bash

########################################
# ZimaOS
########################################

REMOTE_HOST="192.168.x.x"
REMOTE_USER="your-user"
SSH_PORT=22

########################################
# Remote paths
########################################

# External drive as shown in ZimaOS Files (ZimaOS mounts
# external drives under /media by label).
REMOTE_ROOT="/media/YOUR-DRIVE"

# Live application data on the ZimaOS system drive. Only used
# by restore.sh (--target appdata) to restore backed-up AppData
# in place, e.g. after a fresh ZimaOS install.
REMOTE_APPDATA="/DATA/AppData"

# Containers stopped/restarted around a restore.sh --target
# appdata run, so files aren't restored under an app that's
# actively writing to them.
APPS="vaultwarden jellyfin qbittorrent nextcloud immich-server immich-postgres"

########################################
# Local backup
########################################

# Folder on this machine that receives the backup. It holds backup
# content, not credentials, so keep it out of a credentials-only folder.
LOCAL_BACKUP="/path/to/local/backup"

########################################
# Folders
#
# Each entry is a top-level folder of
# REMOTE_ROOT that is synchronized in
# full, no matter what is inside it.
########################################

FOLDERS=(
    "Backups"
    "Gallery"
)

########################################
# Push Linux Mint data to ZimaOS
#
# Optional reverse direction, run after
# the pull on full runs: PUSH_SOURCE on
# this machine is mirrored (rsync
# --delete) onto PUSH_TARGET, a drive
# mounted on the ZimaOS server. Leave
# PUSH_SOURCE empty to disable.
# PUSH_EXCLUDES are top-level folders of
# PUSH_SOURCE to skip (e.g. the folder
# that holds the ZimaOS backup itself).
########################################

PUSH_SOURCE=""
PUSH_TARGET="/media/YOUR-OTHER-DRIVE"
PUSH_EXCLUDES=(
    "backup"
)

########################################
# Logging
########################################

LOG_DIR="./logs"

########################################
# Server-side backup freshness
#
# backup.sh warns when the server's own
# zimaos/backup.sh hasn't run within
# this many hours (ZimaOS updates are
# known to wipe root's crontab).
########################################

SERVER_BACKUP_LOG="$REMOTE_ROOT/Backups/backup.log"
MAX_SERVER_BACKUP_AGE_HOURS=48
