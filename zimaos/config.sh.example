#!/bin/sh

########################################
# ZimaOS server-side backup
#
# Runs locally on the ZimaOS box (cron/
# scheduled task). Copy this file to
# config.sh and adjust as needed.
########################################

# Log file. Must live under a path that
# already exists once DST_APPDATA's
# parent is created (see backup.sh).
LOG="/media/DATA4TB/Backups/backup.log"

# Live application data (Docker bind
# mounts) and where it gets backed up to
# on the external drive.
SRC_APPDATA="/DATA/AppData"
DST_APPDATA="/media/DATA4TB/Backups/AppData"

# Projects on the system drive (code is
# on GitHub, but gitignored files like
# .env.docker only exist here) and where
# they get backed up to.
SRC_PROJECTS="/DATA/Projects"
DST_PROJECTS="/media/DATA4TB/Backups/Projects"

# Full external drive and the second
# drive it gets mirrored to.
SRC_DATA="/media/DATA4TB"
DST_MIRROR="/media/BACKUP4TB"

# Folder(s) under SRC_DATA to exclude
# from the SRC_DATA -> DST_MIRROR pass.
MIRROR_EXCLUDE="nc-skeleton"

# Containers stopped before backing up
# SRC_APPDATA (for filesystem-consistent
# copies) and restarted right after.
APPS="vaultwarden jellyfin qbittorrent nextcloud immich-server immich-postgres postgresql"

########################################
# Detached backup drive + failover
# (optional; everything below is
# ignored while the UUIDs are empty)
########################################

# Filesystem UUIDs of the two drives:
#   blkid -o value -s UUID /dev/sdX
DATA_UUID=""
MIRROR_UUID=""

# Persistent folder for the scripts'
# state (lock, failover flag, where the
# detached drive hangs). Must survive
# reboots, so keep it off /var.
STATE_DIR="/DATA/AppData/homelab-backup"

# yes: after the nightly mirror the
# backup drive is detached (unmounted,
# spun down, removed from the OS) and
# only re-attached for the next run.
MIRROR_DETACH="no"

# yes: install-timer.sh also installs
# the failover watchdog (every 5 min).
# When the data drive disappears or
# stops answering FAIL_THRESHOLD checks
# in a row, the apps are stopped, the
# backup drive is bind-mounted at
# SRC_DATA and the apps restarted.
FAILOVER_ENABLED="no"
FAIL_THRESHOLD="3"
