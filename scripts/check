#!/usr/bin/env bash
# One command for lint + tests: what the pre-push hook and CI run.
#   scripts/check
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

echo "== shellcheck"
# POSIX sh scripts (they run on ZimaOS, whose /bin/sh is not bash)
shellcheck -x -P SCRIPTDIR -s sh zimaos/backup.sh zimaos/failover-check.sh zimaos/failback.sh zimaos/lib/drive.sh notify.sh tests/fakes/*
# bash scripts
shellcheck -x -P SCRIPTDIR backup.sh restore.sh mirror-to-external.sh install-timer.sh zimaos/install-timer.sh tests/run.sh scripts/check

if command -v shfmt >/dev/null 2>&1; then
    echo "== shfmt"
    shfmt -d -i 4 -ci backup.sh restore.sh lib/*.sh zimaos/lib/drive.sh zimaos/failover-check.sh zimaos/failback.sh tests/run.sh scripts/check
else
    echo "== shfmt not installed, skipping"
fi

echo "== tests"
tests/run.sh

echo "== clean-code audit (report only until the long functions are split)"
scripts/clean-code-audit
